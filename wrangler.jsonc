{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leyclara",
  // Cuenta de Cloudflare (venuxgaming). No es un secreto.
  "account_id": "8ece96f1cb9468880aceb096264ea49c",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin/*"] },
  "observability": { "enabled": true },
  "vars": { "SEARCH_MODE": "vector", "CONTEXT_K": "8", "CACHE_HORAS": "24" },
  // Mientras no exista el dominio propio, queda en leyclara.<subdominio>.workers.dev.
  "workers_dev": true,
  // Dominio propio: descomentar cuando la zona manuel.ac esté en esta misma cuenta de Cloudflare.
  // "routes": [{ "pattern": "ley.manuel.ac", "custom_domain": true }],

  // Máximo 10 solicitudes por minuto por IP a /api/ask y /api/search (cada una aparte).
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  // D1: `wrangler dev` usa una copia local. scripts/deploy.sh reemplaza database_id por el de `wrangler d1 create leyclara`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leyclara",
      "database_id": "7a384612-effa-4244-82d3-0b6646a5e103",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI y Vectorize no tienen simulador local: siempre remotos (requiere `wrangler login`).
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "leyclara-chunks", "remote": true }],

  "env": {
    // `wrangler dev --env offline`: solo D1 local, búsqueda FTS. No necesita cuenta de Cloudflare.
    "offline": {
      "vars": { "SEARCH_MODE": "fts", "CONTEXT_K": "8" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "leyclara",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
